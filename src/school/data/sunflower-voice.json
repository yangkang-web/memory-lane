  "lines": [
    {
      "id": "promise",
      "start": 3.3,
      "end": 8.126,
      "text": "I'd write you a love letter every day, until you said yes to being my girlfriend."
    },
    {
      "id": "tomorrow",
      "start": 12.0,
      "end": 13.592,
      "text": "Deal. You'll have it tomorrow."
    },
    {
      "id": "letter",
      "start": 19.2,
      "end": 27.324,
      "text": "Today is day N of liking you. If you haven't said yes, I'll try a little harder tomorrow. What I'm best at is always liking you."
    },
    {
      "id": "secret",
      "start": 31.0,
      "end": 38.59467,
      "text": "Remember saying you love sunflowers? They always turn toward the sun. And me? I only want to turn toward you."
    },
    {
      "id": "ask",
      "start": 47.1,
      "end": 49.31467,
      "text": "Then, may I ask you something a little early?"
    },
    {
      "id": "confession",
      "start": 51.0,
      "end": 53.38533,
      "text": "Will today's leading lady be my girlfriend?"
    },
    {
      "id": "yes",
      "start": 56.8,
      "end": 58.43467,
      "text": "As you wish, my girlfriend."
    }
  ],
